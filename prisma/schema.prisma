generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SISWA
  PANITIA
  ADMIN
}

enum OtpPurpose {
  REGISTER
  LOGIN
  RESET
}

enum MetodePembayaran {
  OFFLINE
  ONLINE
}

enum StatusVerifikasi {
  PENDING
  REVISI
  VALID
  LUNAS
}

enum StatusRegistrasiUlang {
  BELUM_HADIR
  HADIR_VERIFIKASI
  SUDAH_LENGKAP
  ADA_KEKURANGAN
}

model User {
  id           String      @id @default(uuid())
  panitiaId    String?     @unique
  email        String      @unique
  username     String?     @unique
  password     String
  role         Role        @default(SISWA)
  isVerified   Boolean     @default(false)
  otpCode      String?
  otpExpiredAt DateTime?
  otpPurpose   OtpPurpose?
  otpAttempts  Int         @default(0)
  namaLengkap  String?
  noHp         String?
  avatarUrl    String?
  aktif        Boolean     @default(true)
  loginGagal   Int         @default(0)
  terkunciSampai DateTime?
  passwordChangedAt DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  biodata      BiodataSiswa?
  berkas       BerkasSiswa?
  pembayaran   Pembayaran?
  komentars    KomentarPanitia[]
  articles     Article[]

  @@map("users")
}

model Jurusan {
  id               String         @id @default(uuid())
  namaJurusan      String         @unique
  kuota            Int            @default(100)
  biayaPendaftaran Float          @default(0)
  aktif            Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  biodatasUtama    BiodataSiswa[] @relation("JurusanUtama")
  biodatasCadangan BiodataSiswa[] @relation("JurusanCadangan")
  biodatasDiterima BiodataSiswa[] @relation("JurusanDiterima")

  @@map("jurusans")
}

model GelombangPendaftaran {
  id             String         @id @default(uuid())
  nama           String         @unique
  tanggalMulai   DateTime
  tanggalSelesai DateTime
  aktif          Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  biodatas       BiodataSiswa[]

  @@map("gelombang_pendaftaran")
}

model Pengaturan {
  kunci     String   @id
  nilai     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("pengaturan")
}

model BiodataSiswa {
  id                 String                @id @default(uuid())
  userId             String                @unique
  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  namaLengkap        String
  avatarUrl          String?
  nik                String?               @unique
  nisn               String?               @unique
  nis                String?
  jenisKelamin       String?
  tempatLahir        String?
  tanggalLahir       DateTime?
  agama              String?
  alamat             String?
  noHpSiswa          String?

  namaAyah           String?
  noHpAyah           String?
  namaIbu            String?
  noHpIbu            String?

  asalSmp            String?

  jurusanId          String?
  jurusan            Jurusan?              @relation("JurusanUtama", fields: [jurusanId], references: [id])
  jurusanCadanganId  String?
  jurusanCadangan    Jurusan?              @relation("JurusanCadangan", fields: [jurusanCadanganId], references: [id])
  jurusanDiterimaId  String?
  jurusanDiterima    Jurusan?              @relation("JurusanDiterima", fields: [jurusanDiterimaId], references: [id])

  gelombangId        String?
  gelombang          GelombangPendaftaran? @relation(fields: [gelombangId], references: [id])

  statusFormulir     StatusVerifikasi      @default(PENDING)
  diajukanPada       DateTime?

  statusDaftarUlang  StatusRegistrasiUlang @default(BELUM_HADIR)
  catatanDaftarUlang String?

  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([jurusanDiterimaId])
  @@index([gelombangId])
  @@map("biodata_siswa")
}

model BerkasSiswa {
  id                String           @id @default(uuid())
  userId            String           @unique
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  fileIjazahSkl     String?
  fileKk            String?
  fileAkteKelahiran String?
  fileIdentitasAnak String?
  fileKip           String?
  folderPath        String?

  statusVerifikasi  StatusVerifikasi @default(PENDING)
  catatanAdmin      String?

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@map("berkas_siswa")
}

model Pembayaran {
  id              String           @id @default(uuid())
  userId          String           @unique
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  metode          MetodePembayaran @default(OFFLINE)
  jumlah          Float            @default(0)
  buktiUrl        String?          
  status          StatusVerifikasi @default(PENDING)
  
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@map("pembayaran")
}

model KomentarPanitia {
  id        String   @id @default(uuid())
  userId    String   
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  panitiaId String   
  pesan     String
  kategori  String   
  batchId   String?
  dibacaPada DateTime?
  
  createdAt DateTime @default(now())

  @@index([userId, dibacaPada])
  @@index([batchId])
  @@map("komentar_panitia")
}

model ArticleCategory {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now())
  articles  Article[]

  @@map("article_categories")
}

model Article {
  id         String          @id @default(uuid())
  title      String
  slug       String          @unique
  content    String          @db.Text
  excerpt    String?
  thumbnail  String?
  published  Boolean         @default(false)
  publishedAt DateTime?
  authorId   String
  author     User            @relation(fields: [authorId], references: [id])
  categoryId String
  category   ArticleCategory @relation(fields: [categoryId], references: [id])
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([published, publishedAt])
  @@map("articles")
}

model AuditLog {
  id        String   @id @default(uuid())
  aktorId   String
  aksi      String
  targetId  String?
  detail    String?  @db.Text
  createdAt DateTime @default(now())

  @@index([aktorId])
  @@index([aksi])
  @@index([createdAt])
  @@map("audit_log")
}
